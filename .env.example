# ── Cliente (Vite) ─────────────────────────────────────────────────────────
# URL pública de la API de salas. Vacío = mismo origen, con el proxy de Vite
# hacia http://localhost:8788 (desarrollo). En Vercel: https://api-prl.orpira.es
VITE_API_URL=

# ── Servidor (Docker Compose en el VPS; copia este archivo a .env) ──────────
# Orígenes que pueden llamar a la API, separados por comas y exactos (sin barra final).
# En compose es obligatoria: si falta, el contenedor no arranca.
PRL_ALLOWED_ORIGINS=https://prl.orpira.es

# Solo con un proxy propio delante (Nginx Proxy Manager): permite tomar la IP real de
# X-Forwarded-For para los límites de peticiones. Nunca lo actives sin proxy.
PRL_TRUST_PROXY=true

# Opcionales fuera de Docker (valores por defecto):
# PORT=8788
# HOST=0.0.0.0
# PRL_DATA_DIR=./.data
